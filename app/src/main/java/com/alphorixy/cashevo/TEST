@Composable
fun SocialCircleIcon(platform: String, onClick: () -> Unit) {
    Box(
        modifier = Modifier
            .size(38.dp)
            .clip(CircleShape)
            .background(CardColor)
            .clickable { onClick() },
        contentAlignment = Alignment.Center
    ) {
        val tint = Color.White
        androidx.compose.foundation.Canvas(modifier = Modifier.size(18.dp)) {
            when (platform) {
                "X" -> {
                    drawLine(tint, Offset(0f, 0f), Offset(size.width, size.height), strokeWidth = 3.5f)
                    drawLine(tint, Offset(0f, size.height), Offset(size.width, 0f), strokeWidth = 3.5f)
                }
                "FB" -> {
                    drawRect(tint, size = Size(size.width, size.height), style = Stroke(width = 2f))
                    val path = androidx.compose.ui.graphics.Path().apply {
                        moveTo(size.width * 0.65f, size.height)
                        lineTo(size.width * 0.65f, size.height * 0.55f)
                        lineTo(size.width * 0.8f, size.height * 0.55f)
                        lineTo(size.width * 0.8f, size.height * 0.35f)
                        lineTo(size.width * 0.65f, size.height * 0.35f)
                        lineTo(size.width * 0.65f, size.height * 0.25f)
                        quadraticBezierTo(size.width * 0.65f, size.height * 0.2f, size.width * 0.75f, size.height * 0.2f)
                        lineTo(size.width * 0.8f, size.height * 0.2f)
                        lineTo(size.width * 0.8f, 0f)
                        lineTo(size.width * 0.6f, 0f)
                        quadraticBezierTo(size.width * 0.4f, 0f, size.width * 0.4f, size.height * 0.3f)
                        lineTo(size.width * 0.4f, size.height * 0.35f)
                        lineTo(size.width * 0.25f, size.height * 0.35f)
                        lineTo(size.width * 0.25f, size.height * 0.55f)
                        lineTo(size.width * 0.4f, size.height * 0.55f)
                        lineTo(size.width * 0.4f, size.height)
                        close()
                    }
                    drawPath(path, color = tint)
                }
                "INS" -> {
                    drawRoundRect(tint, size = size, cornerRadius = androidx.compose.ui.geometry.CornerRadius(6f, 6f), style = Stroke(width = 2f))
                    drawCircle(tint, radius = size.width / 4f, style = Stroke(width = 2f))
                    drawCircle(tint, radius = 1.5f, center = Offset(size.width * 0.75f, size.height * 0.25f))
                }
                "REDDIT" -> {
                    drawCircle(tint, radius = size.width / 2f, style = Stroke(width = 2f))
                    drawCircle(tint, radius = size.width * 0.15f, center = Offset(size.width * 0.35f, size.height * 0.45f))
                    drawCircle(tint, radius = size.width * 0.15f, center = Offset(size.width * 0.65f, size.height * 0.45f))
                }
                "DIS" -> {
                    drawOval(tint, size = Size(size.width, size.height * 0.8f), style = Stroke(width = 2f))
                }
                "YT" -> {
                    drawRoundRect(tint, size = size, cornerRadius = androidx.compose.ui.geometry.CornerRadius(5f, 5f), style = Stroke(width = 2f))
                    val path = androidx.compose.ui.graphics.Path().apply {
                        moveTo(size.width * 0.38f, size.height * 0.3f)
                        lineTo(size.width * 0.7f, size.height * 0.5f)
                        lineTo(size.width * 0.38f, size.height * 0.7f)
                        close()
                    }
                    drawPath(path, color = tint)
                }
                "TG" -> {
                    val path = androidx.compose.ui.graphics.Path().apply {
                        moveTo(0f, size.height * 0.5f)
                        lineTo(size.width, 0f)
                        lineTo(size.width * 0.3f, size.height)
                        lineTo(size.width * 0.5f, size.height * 0.6f)
                        close()
                    }
                    drawPath(path, color = tint)
                }
            }
        }
    }
}



