            // شريط التبويبات الثلاثة أسفل الرصيد مباشرة
            ScrollableTabRow(
                selectedTabIndex = selectedTab,
                containerColor = Color.Transparent,
                contentColor = Gold,
                edgePadding = 0.dp,
                indicator = {}
